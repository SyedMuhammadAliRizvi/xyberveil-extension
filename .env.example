APP_NAME="Kestrel VPN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VPS_API_TOKEN=
SCRIPT_BASE_URL="https://scripts.tecclubb.com"
TRIAL_DAYS=7
IPINFO_TOKEN=your_ipinfo_token

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="/auth/google/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="/auth/apple/callback"
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# SecureProxy — managed locally in this panel (no external vps-monitor API required)
PROXY_SECRET_KEY=
PROXY_AGENT_DOWNLOAD_URL="${APP_URL}"
PROXY_ALLOWED_AGENT_IP=127.0.0.1
PROXY_ACCESS_TOKEN_TTL=60
PROXY_REFRESH_TOKEN_TTL_DAYS=30
PROXY_TRIAL_DAYS=30

# Legacy vps-monitor settings (no longer used by the admin panel)
# PROXY_MONITOR_BASE_URL=
# PROXY_MONITOR_ADMIN_USER=
# PROXY_MONITOR_ADMIN_PASS=

FREE_USER_MAX_DEVICES=1
# EDIS Global KVM API (per-VPS monthly bandwidth usage)
EDIS_EMAIL=
EDIS_PASSWORD=

# OneProvider API (OnePanel -> API Access)
ONEPROVIDER_API_KEY=
ONEPROVIDER_CLIENT_KEY=

# OVHcloud API (inventory only - no bandwidth quota data available)
# Region: ovh-eu | ovh-us | ovh-ca (must match your OVH account's region)
OVH_ENDPOINT=ovh-eu
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
